NODE_ENV=development
PORT=5000
# Atlas URI OR a local replica set, never a standalone mongod.
MONGODB_URI=mongodb://127.0.0.1:27017/amihub_crm?replicaSet=rs0
APP_ORIGINS=http://localhost:4200
BUSINESS_TIMEZONE=Asia/Kolkata
# Set only to trusted reverse-proxy IP/subnet(s), e.g. loopback.
# Never set this to true for an Internet-exposed Node process.
TRUST_PROXY=
LOG_LEVEL=info
# Optional: enable automatic recurring invoices when running npm run worker.
# Use the ID of a dedicated, active Accounts user. Empty = reminders/aging only.
WORKER_USER_ID=
