{
  "name": "amihub-crm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "setup:owner": "node --env-file-if-exists=.env scripts/create-owner.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --test test/integration.test.js",
    "check": "node scripts/check-syntax.js",
    "worker": "node --env-file-if-exists=.env src/jobs/worker.js",
    "test:unit": "node --test test/unit.test.js",
    "test:http": "node --test test/http.test.js",
    "connect:frontend": "node scripts/connect-frontend.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^9.0.0",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "mongodb-memory-server": "^10.2.0"
  }
}
